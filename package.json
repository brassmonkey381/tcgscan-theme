    "url": "https://github.com/brassmonkey381/tcgscan-theme.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-native": "0.85.3",
    "typescript": "~6.0.3"
  }
}
