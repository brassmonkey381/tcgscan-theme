{
  "name": "tcgscan-theme",
  "version": "0.9.0",
  "description": "Shared design tokens for the TCGScan apps: brand color palettes (light/dark, four variants), the type scale, spacing and radii, and a WCAG contrast checker. The single source both tcgscan-app and michi-maker theme from.",
